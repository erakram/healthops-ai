# Copy this file to .env and fill in your key. Never commit .env.
# Free key: https://console.groq.com/keys
GROQ_API_KEY=

# Optional settings (defaults shown)
# DATABASE_URL=sqlite:///data/healthops.db        # postgres: postgresql+psycopg://user:pass@host/db
# GROQ_MODEL=openai/gpt-oss-120b
# EXTRACTION_MODEL=openai/gpt-oss-120b            # reads documents
# REVIEW_MODEL=openai/gpt-oss-120b                # looks for inconsistencies
# JWT_SECRET=change-me-in-production
# SEED_DEMO_DATA=true                              # demo users, one-click sign-in and claim history
# JOB_MAX_ATTEMPTS=3
# MAX_UPLOAD_MB=10
