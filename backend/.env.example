# Copy this file to .env and fill in a key. Never commit .env.
# Claude is used when ANTHROPIC_API_KEY is set (https://platform.claude.com/settings/keys);
# otherwise Groq (free key: https://console.groq.com/keys).
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# Optional settings (defaults shown)
# LLM_PROVIDER=anthropic                          # anthropic | groq (default: anthropic if its key is set)
# LLM_MODEL=claude-opus-5-5                       # default for both roles; groq default: openai/gpt-oss-120b
# EXTRACTION_MODEL=claude-opus-5-5                # reads documents
# REVIEW_MODEL=claude-opus-5-5                    # review, denial triage, appeals
# CLAUDE_EFFORT=medium                            # low | medium | high | xhigh | max
# DATABASE_URL=sqlite:///data/healthops.db        # postgres: postgresql+psycopg://user:pass@host/db
# JWT_SECRET=change-me-in-production
# SEED_DEMO_DATA=true                              # demo users, one-click sign-in and claim history
# JOB_MAX_ATTEMPTS=3
# MAX_UPLOAD_MB=10
# PAYER_DELAY_SECONDS=6                            # how long the mock payer takes to answer
